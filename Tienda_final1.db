BEGIN TRANSACTION;
CREATE TABLE IF NOT EXISTS "Presupuestos" (
	"idPresupuesto"	INTEGER,
	"NombreDestinatario"	TEXT NOT NULL,
	"FechaCreacion"	TEXT NOT NULL,
	PRIMARY KEY("idPresupuesto" AUTOINCREMENT)
);
CREATE TABLE IF NOT EXISTS "PresupuestosDetalle" (
	"idPresupuesto"	INTEGER NOT NULL,
	"idProducto"	INTEGER NOT NULL,
	"Cantidad"	INTEGER NOT NULL,
	PRIMARY KEY("idPresupuesto","idProducto"),
	FOREIGN KEY("idPresupuesto") REFERENCES "Presupuestos"("idPresupuesto"),
	FOREIGN KEY("idProducto") REFERENCES "Productos"("idProducto")
);
CREATE TABLE IF NOT EXISTS "Productos" (
	"idProducto"	INTEGER,
	"Descripcion"	TEXT NOT NULL,
	"Precio"	INTEGER NOT NULL,
	PRIMARY KEY("idProducto" AUTOINCREMENT)
);
CREATE TABLE IF NOT EXISTS "Usuario" (
	"id"	INTEGER NOT NULL,
	"Nombre"	INTEGER,
	"User"	TEXT NOT NULL,
	"Pass"	TEXT NOT NULL,
	"Rol"	TEXT,
	PRIMARY KEY("id" AUTOINCREMENT)
);
