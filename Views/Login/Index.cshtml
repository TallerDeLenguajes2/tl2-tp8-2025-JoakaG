@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mx-auto max-w-sm mt-12 p-6 bg-white shadow-xl rounded-lg border border-gray-200">

<h2 class=" text-2xl font-bold text-gray-800 text-center mb-6">Iniciar Sesion</h2>

    <!-- INICIO: EL BLOQUE if QUE MUESTRA EL ERROR SIMPLE -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-3 mb-4 text-sm font-medium text-red-700 bg-red-100 rounded-lg border border-red-300" role="alert">
            @Model.ErrorMessage
        </div>
    }

    <!-- El formulario apunta a la acción 'Login' en el controlador 'Login' -->
    <form asp-action="Login" method="post" class="space-y-4">

        <div>
            <label asp-for="Username" class="block text-sm font-medium text-gray-700">Usuario</label>
            <div class="mt-1">
                <input asp-for="Username" type="text"
                    class="w-full p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-gray-700">Contraseña</label>
            <div class="mt-1">
                <input asp-for="Password" type="password"
                    class="w-full p-2 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="pt-2">
            <button type="submit" class="w-full py-2 px-4 border border-transparent btn-success rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 transition duration-150">
                Ingresar
            </button>
        </div>
    </form>
</div>